#!/bin/sh
# Native MinGW defaults to 64-bit; PRISM_MINGW=0 keeps the legacy path.
if [ "${PRISM_MINGW:-1}" = 1 ]; then
    case `uname -s` in
        MINGW*|MSYS*|Windows_NT)
            case ${PRISM_MINGW_BITS:-64} in
                32|64) ;;
                *) echo 'PRISM_MINGW_BITS must be 32 or 64' >&2; exit 1 ;;
            esac
            BINDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
            exec "$BINDIR/prism_up_mingw${PRISM_MINGW_BITS:-64}.exe" -c \
                -p "${PRISM_PAREA:-8000000}" -s "${PRISM_STACK:-5000000}" \
                -b "${PRISM_TRAIL:-2000000}" -t "${PRISM_TABLE:-10000000}" \
                "$BINDIR/bp.out" "$BINDIR/prism.out" "$BINDIR/foc.out" "$BINDIR/batch.out" "$@"
            ;;
    esac
fi

BINDIR=`dirname $0`
PAREA=80000000	# Size of program area
STACK=100000000	# Size of control stack and heap
TRAIL=100000000	# Size of trail stack
TABLE=100000000	# Size of table area

case `uname -s` in
    Linux)
        BINARY=$BINDIR/prism_up_linux.bin
        ;;
    Darwin)
        BINARY=$BINDIR/prism_up_darwin.bin
        ;;
    CYGWIN*)
        BINARY=$BINDIR/prism_up_cygwin.exe
        ;;
    MINGW*|MSYS*|Windows_NT)
        case ${PRISM_MINGW_BITS:-64} in
            32|64)
            BINARY=$BINDIR/prism_up_mingw${PRISM_MINGW_BITS:-64}.exe
	    ;;
            *) echo 'PRISM_MINGW_BITS must be 32 or 64' >&2; exit 1 ;;
        esac
        ;;
esac

if [ ! -x "$BINARY" ]; then
    echo "Sorry, but PRISM doesn't support this system." 1>&2
    exit 1
fi

#echo $BINARY -p $PAREA -s $STACK -b $TRAIL -t $TABLE $BINDIR/bp.out $BINDIR/prism.out $BINDIR/foc.out $BINDIR/batch.out ${1+"$@"}
exec $BINARY -p $PAREA -s $STACK -b $TRAIL -t $TABLE $BINDIR/bp.out $BINDIR/prism.out $BINDIR/foc.out $BINDIR/batch.out ${1+"$@"}
